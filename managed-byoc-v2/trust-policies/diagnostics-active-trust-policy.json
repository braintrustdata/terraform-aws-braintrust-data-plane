{
  "Statement": [
    {
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "<DIAGNOSTICS_ACCESS_EXPIRES_AT>"
        },
        "Null": {
          "identitystore:UserId": "false"
        },
        "StringEquals": {
          "identitystore:UserId": [
            "<ENGINEER_SOURCE_IDENTITY>"
          ],
          "sts:SourceIdentity": "${identitystore:UserId}"
        }
      },
      "Effect": "Allow",
      "Principal": {
        "AWS": "<BRAINTRUST_DIAGNOSTICS_PRINCIPAL_ARN>"
      },
      "Sid": "AllowNamedDiagnosticsParticipants"
    },
    {
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringNotEquals": {
          "sts:RoleSessionName": "${identitystore:UserId}"
        }
      },
      "Effect": "Deny",
      "Principal": {
        "AWS": "<BRAINTRUST_DIAGNOSTICS_PRINCIPAL_ARN>"
      },
      "Sid": "DenyMismatchedDiagnosticsSessionName"
    }
  ],
  "Version": "2012-10-17"
}
