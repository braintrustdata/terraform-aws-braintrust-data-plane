{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OperateManagedSchedules",
      "Effect": "Allow",
      "Action": "scheduler:UpdateSchedule",
      "Resource": "arn:<AWS_PARTITION>:scheduler:<AWS_REGION>:<AWS_ACCOUNT_ID>:schedule/*/<MANAGED_RESOURCE_PREFIX>*"
    },
    {
      "Sid": "PassSchedulerExecutionRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/<MANAGED_RESOURCE_PREFIX>*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    }
  ]
}
