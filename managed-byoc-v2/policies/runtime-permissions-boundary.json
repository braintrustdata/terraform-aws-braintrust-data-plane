{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyWorkloadPolicyPermissions",
      "Effect": "Allow",
      "NotAction": "iam:*",
      "Resource": "*"
    },
    {
      "Sid": "AllowRuntimeRoleMetadata",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowRuntimePassRoleForLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/<MANAGED_RESOURCE_PREFIX>*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyIdentityAndAccountAdministration",
      "Effect": "Deny",
      "Action": [
        "account:*",
        "billing:*",
        "controltower:*",
        "identitystore:*",
        "organizations:*",
        "payments:*",
        "sso:*",
        "sso-directory:*",
        "tax:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAuditAndSecurityControlTampering",
      "Effect": "Deny",
      "Action": [
        "access-analyzer:ApplyArchiveRule",
        "access-analyzer:CreateArchiveRule",
        "access-analyzer:Delete*",
        "access-analyzer:UpdateArchiveRule",
        "cloudtrail:Delete*",
        "cloudtrail:Put*",
        "cloudtrail:StartLogging",
        "cloudtrail:Stop*",
        "cloudtrail:Update*",
        "config:Delete*",
        "config:Put*",
        "config:Stop*",
        "guardduty:Delete*",
        "guardduty:Disable*",
        "guardduty:Disassociate*",
        "guardduty:Update*",
        "securityhub:BatchDisable*",
        "securityhub:Delete*",
        "securityhub:Disable*",
        "securityhub:Disassociate*",
        "securityhub:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBootstrapStorageAccess",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:<AWS_PARTITION>:s3:::<STATE_BUCKET_NAME>",
        "arn:<AWS_PARTITION>:s3:::<STATE_BUCKET_NAME>/*",
        "arn:<AWS_PARTITION>:s3:::<OPERATION_LOG_BUCKET_NAME>",
        "arn:<AWS_PARTITION>:s3:::<OPERATION_LOG_BUCKET_NAME>/*"
      ]
    },
    {
      "Sid": "DenyKeyAdministration",
      "Effect": "Deny",
      "Action": [
        "kms:CreateKey",
        "kms:PutKeyPolicy",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:DeleteAlias",
        "kms:UpdateAlias",
        "kms:TagResource",
        "kms:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDirectKeyGrants",
      "Effect": "Deny",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "BoolIfExists": {
          "kms:GrantIsForAWSResource": "false"
        }
      }
    },
    {
      "Sid": "DenyRuntimeRoleAssumptionByDefault",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "*"
    },
    {
      "Sid": "DenyBootstrapRoleAssumption",
      "Effect": "Deny",
      "Action": "sts:AssumeRole",
      "Resource": "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/braintrust-byoc/*"
    },
    {
      "Sid": "DenyBootstrapIamChanges",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": [
        "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/braintrust-byoc/*",
        "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:policy/braintrust-byoc/*"
      ]
    }
  ]
}
