{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyIdentityPolicyPermissions",
      "Effect": "Allow",
      "NotAction": [
        "iam:CreateServiceLinkedRole",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowScopedPassRoleWithinBoundary",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/<MANAGED_RESOURCE_PREFIX>*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "events.amazonaws.com",
            "lambda.amazonaws.com",
            "monitoring.rds.amazonaws.com",
            "spot.amazonaws.com",
            "vpc-flow-logs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowApprovedServiceLinkedRolesWithinBoundary",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "autoscaling.amazonaws.com",
            "ecs.amazonaws.com",
            "ecs.application-autoscaling.amazonaws.com",
            "elasticache.amazonaws.com",
            "elasticloadbalancing.amazonaws.com",
            "rds.amazonaws.com",
            "spot.amazonaws.com",
            "vpcorigin.cloudfront.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyAccountAndOrganizationAdministration",
      "Effect": "Deny",
      "Action": [
        "account:CloseAccount",
        "account:Put*",
        "account:Delete*",
        "billing:*",
        "controltower:*",
        "identitystore:*",
        "organizations:*",
        "payments:*",
        "sso:*",
        "sso-directory:*",
        "tax:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAuditAndSecurityControlTampering",
      "Effect": "Deny",
      "Action": [
        "access-analyzer:ApplyArchiveRule",
        "access-analyzer:CreateArchiveRule",
        "access-analyzer:Delete*",
        "access-analyzer:UpdateArchiveRule",
        "cloudtrail:Delete*",
        "cloudtrail:Put*",
        "cloudtrail:StartLogging",
        "cloudtrail:Stop*",
        "cloudtrail:Update*",
        "config:Delete*",
        "config:Put*",
        "config:Stop*",
        "guardduty:Delete*",
        "guardduty:Disable*",
        "guardduty:Disassociate*",
        "guardduty:Update*",
        "securityhub:BatchDisable*",
        "securityhub:Delete*",
        "securityhub:Disable*",
        "securityhub:Disassociate*",
        "securityhub:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyHumanIdentityAdministration",
      "Effect": "Deny",
      "Action": [
        "iam:*AccessKey*",
        "iam:*AccountAlias",
        "iam:*AccountPasswordPolicy",
        "iam:*Group*",
        "iam:*LoginProfile*",
        "iam:*User*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBootstrapIamChanges",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": [
        "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:role/braintrust-byoc/*",
        "arn:<AWS_PARTITION>:iam::<AWS_ACCOUNT_ID>:policy/braintrust-byoc/*"
      ]
    },
    {
      "Sid": "DenyRuntimeRoleAssumption",
      "Effect": "Deny",
      "Action": [
        "ec2-instance-connect:OpenTunnel",
        "ec2-instance-connect:SendSSHPublicKey",
        "ssm:SendCommand",
        "ssm:StartSession",
        "sts:AssumeRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyApplicationLogContents",
      "Effect": "Deny",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:GetLogGroupFields",
        "logs:GetLogRecord",
        "logs:GetQueryResults",
        "logs:StartLiveTail",
        "logs:StartQuery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDirectWorkloadAndDatabaseReads",
      "Effect": "Deny",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:GetItem",
        "dynamodb:PartiQLSelect",
        "dynamodb:Query",
        "dynamodb:Scan",
        "ec2:GetConsoleOutput",
        "ec2:GetPasswordData",
        "ecs:ExecuteCommand",
        "eks:AccessKubernetesApi",
        "lambda:InvokeAsync",
        "lambda:InvokeFunctionUrl",
        "rds:DownloadCompleteDBLogFile",
        "rds:DownloadDBLogFilePortion",
        "sqs:ReceiveMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInvocationExceptDeploymentHooks",
      "Effect": "Deny",
      "Action": "lambda:InvokeFunction",
      "NotResource": [
        "arn:<AWS_PARTITION>:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:<MANAGED_RESOURCE_PREFIX>-MigrateDatabaseFunction",
        "arn:<AWS_PARTITION>:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:<MANAGED_RESOURCE_PREFIX>-QuarantineWarmupFunction"
      ]
    },
    {
      "Sid": "DenyDirectKeyGrants",
      "Effect": "Deny",
      "Action": "kms:CreateGrant",
      "Resource": "*",
      "Condition": {
        "BoolIfExists": {
          "kms:GrantIsForAWSResource": "false"
        }
      }
    },
    {
      "Sid": "DenyDecryptOutsideDocumentedServices",
      "Effect": "Deny",
      "Action": [
        "kms:Decrypt",
        "kms:ReEncryptFrom"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "kms:ViaService": [
            "secretsmanager.<AWS_REGION>.amazonaws.com",
            "s3.<AWS_REGION>.amazonaws.com",
            "lambda.<AWS_REGION>.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyEc2DataExportAndTrafficMirroring",
      "Effect": "Deny",
      "Action": [
        "ec2:*ImageAttribute",
        "ec2:*SnapshotAttribute",
        "ec2:*TrafficMirror*",
        "ec2:CreateInstanceExportTask",
        "ec2:CreateStoreImageTask",
        "ec2:ExportImage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyRdsSnapshotExportAndSharing",
      "Effect": "Deny",
      "Action": [
        "rds:CopyDBClusterSnapshot",
        "rds:CopyDBSnapshot",
        "rds:ModifyDBClusterSnapshotAttribute",
        "rds:ModifyDBSnapshotAttribute",
        "rds:StartExportTask"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RestrictBootstrapBucketListing",
      "Effect": "Deny",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:<AWS_PARTITION>:s3:::<STATE_BUCKET_NAME>",
        "arn:<AWS_PARTITION>:s3:::<OPERATION_LOG_BUCKET_NAME>"
      ],
      "Condition": {
        "StringNotLike": {
          "s3:prefix": [
            "braintrust-byoc/<BOOTSTRAP_NAME>/*",
            "braintrust-byoc/operations/<BOOTSTRAP_NAME>/*"
          ]
        }
      }
    },
    {
      "Sid": "ProtectBootstrapStorage",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteBucketPolicy",
        "s3:PutBucket*",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": [
        "arn:<AWS_PARTITION>:s3:::<STATE_BUCKET_NAME>",
        "arn:<AWS_PARTITION>:s3:::<OPERATION_LOG_BUCKET_NAME>"
      ]
    },
    {
      "Sid": "ProtectRetainedBrainstoreData",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:<AWS_PARTITION>:s3:::<BRAINSTORE_BUCKET_NAME>",
        "arn:<AWS_PARTITION>:s3:::<BRAINSTORE_BUCKET_NAME>/*"
      ]
    },
    {
      "Sid": "ProtectRetainedDataPlaneKey",
      "Effect": "Deny",
      "Action": [
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:DeleteAlias",
        "kms:UpdateAlias"
      ],
      "Resource": [
        "<DATA_PLANE_KMS_KEY_ARN>",
        "arn:<AWS_PARTITION>:kms:<AWS_REGION>:<AWS_ACCOUNT_ID>:alias/braintrust/<MANAGED_RESOURCE_PREFIX>"
      ]
    },
    {
      "Sid": "ProtectRetainedDatabaseSnapshots",
      "Effect": "Deny",
      "Action": "rds:DeleteDBSnapshot",
      "Resource": "arn:<AWS_PARTITION>:rds:<AWS_REGION>:<AWS_ACCOUNT_ID>:snapshot:<RETAINED_RDS_SNAPSHOT_PREFIX>*"
    }
  ]
}
