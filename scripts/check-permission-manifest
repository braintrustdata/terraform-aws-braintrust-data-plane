#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.15"
# dependencies = []
# ///
"""Generate the permission manifest from the module's policy definitions and check its Sids.

tests/permission-manifest/*.tftest.hcl apply each policy module under mock providers,
one `run` per profile. This script runs them with `terraform test -json -verbose`,
reads the `test_state` each run emits, and builds the manifest from the policy
documents in it. Terraform's ordinary `terraform test` never runs these files,
because it reads only `tests/`, not its subdirectories.

Each document keeps the placeholders that stand in for deployment values:

    ${input:<name>}    a value the deployment supplies (SENTINELS)
    ${role:<key>}      a role the module creates
    ${binding:<name>}  a value AWS assigns at apply time that isn't an input

Documents built by an `aws_iam_policy_document` data source are rendered from the
data source's `statement` blocks, because each generation file overrides the data
source's `json` with a marker. Every such data source needs this in its file:

    override_data {
      target = data.aws_iam_policy_document.<name>
      values = { json = "{\\"ManifestDocument\\":\\"data.aws_iam_policy_document.<name>\\"}" }
    }

See the Manifest section of
20261103-external-iam-ownership.md for the design.

With no arguments it runs every check and writes nothing. --output also writes the
manifest, and --versions-output writes `terraform version -json`, which names the
Terraform and provider versions the run used. Neither file is committed.

The checks fail on:

    - a Terraform error, or a failed test summary
    - a role, managed policy or instance profile without a `manifest-` override
    - two resources that share an ARN
    - a `manifest-` override value or the mock partition left in a document
    - a module-authored statement without a Sid, with a Sid outside the pattern,
      or with a Sid that repeats within its document (AC-2)
    - a policy resource that no profile's state contains, a policy resource
      header in a file the manifest doesn't cover, or a generation run this
      script doesn't know
    - a module-authored document with an empty Statement
    - a manifest that differs between two runs
    - a placeholder that no document uses, or an `aws_iam_policy_document` that sets
      `source_policy_documents`, `override_policy_documents` or `policy_id`

Run `terraform init -backend=false -test-directory=tests/permission-manifest` first.
`mise run manifest` does both.
"""

import argparse
from dataclasses import dataclass, field
import functools
import json
import os
from pathlib import Path
import re
import subprocess
import sys

REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
TEST_DIRECTORY = "tests/permission-manifest"
MOCK_POLICY_DOCUMENT_SOURCE = "tests/mocks/aws/data.tfmock.hcl"
SCHEMA_VERSION = "1"

# The mock partition and account. The generation files give every resource whose
# ARN a policy references its own `manifest-` ARN in this partition, so the script
# can tell which resource each ARN names.
MANIFEST_PARTITION = "aws-manifest"
OVERRIDE_PREFIX = "manifest-"
DEFAULT_POLICY_VERSION = "2012-10-17"


@dataclass(frozen=True)
class Profile:
    """One `run` block, which applies one policy module."""

    name: str
    module: str  # the directory under modules/

    @property
    def module_key(self) -> str:
        return self.module.replace("-", "_")


@dataclass(frozen=True)
class GenerationFile:
    name: str
    profiles: list[Profile]

    @property
    def path(self) -> str:
        return f"{TEST_DIRECTORY}/{self.name}"


# The generation files in manifest order, and the runs in each, in run order. A
# run the files have and this list doesn't fails the check, so a new profile can't
# be added without listing it here.
