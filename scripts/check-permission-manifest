ACCOUNT_ID = "123456789012"
SECRET = f"arn:{MANIFEST_PARTITION}:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:"
KEY = f"arn:{MANIFEST_PARTITION}:kms:us-east-1:{ACCOUNT_ID}:key/"
SENTINELS = [
