]

# The resource types that carry a policy document, with the kind each one gets in
# the manifest and the attribute that holds the document. The coverage check scans
# these types, plus the attachments, which hold no document of their own.
DOCUMENT_KINDS = {
    "aws_iam_role": ("trust", "assume_role_policy"),
    "aws_iam_role_policy": ("inline", "policy"),
    "aws_iam_policy": ("managed", "policy"),
    "aws_kms_key": ("key", "policy"),
    "aws_s3_bucket_policy": ("bucket", "policy"),
    # Only the endpoints in POLICY_ENDPOINTS set a policy, and the others have none.
    "aws_vpc_endpoint": ("endpoint", "policy"),
}
ATTACHMENT_TYPE = "aws_iam_role_policy_attachment"
SCANNED_TYPES = [resource_type for resource_type in DOCUMENT_KINDS if resource_type != "aws_vpc_endpoint"] + [ATTACHMENT_TYPE]
# The endpoints that carry a policy. An endpoint with `policy =` that isn't listed fails the coverage check.
POLICY_ENDPOINTS = [
    ("vpc", "s3"),
    ("loop-runtime-sandbox-aws-microvm", "loop_runtime_microvm"),
]
# Resource types whose names look like they carry a policy but that hold no document,
# or none that this manifest covers: scaling policies, and the reconcilers that only
# list the policies a role may have.
NON_DOCUMENT_POLICY_TYPES = re.compile(
    r"aws_appautoscaling_policy|aws_autoscaling_policy|aws_cloudfront_\w+_policy|aws_iam_role_policies_exclusive"
)
# Roles are checked by their id in build_substitutions. These types need a per-address
# `manifest-` ARN, because nothing else tells two of them apart.
IDENTITY_TYPES = ["aws_iam_policy", "aws_iam_instance_profile"]
# Headers are matched at the start of a line, indented or not, like
# scripts/check-iam-ownership-tags does for its declarations.
POLICY_RESOURCE_HEADER = re.compile(
    rf'^[ \t]*resource\s+"({"|".join(SCANNED_TYPES)})"\s+"([^"]+)"\s*\{{',
    re.MULTILINE,
)
# Any resource whose type name suggests a policy, to catch a type DOCUMENT_KINDS doesn't know.
POLICY_LIKE_HEADER = re.compile(r'^[ \t]*resource\s+"(aws_[a-z0-9_]*polic(?:y|ies)[a-z_]*)"\s+"([^"]+)"', re.MULTILINE)
ENDPOINT_HEADER = re.compile(r'^[ \t]*resource\s+"aws_vpc_endpoint"\s+"([^"]+)"\s*\{', re.MULTILINE)
# Types whose arn may repeat in one profile. Nothing grants permissions on the
# first four, so a wrong reference is a routing or scaling bug rather than an
# identity one. An event target's arn is the function it invokes, not an ARN of
# its own. Same list as scripts/check-upgrade-plan.
SHARED_ARN_TYPES = {
    "aws_appautoscaling_policy",
    "aws_lb",
    "aws_lb_listener",
    "aws_lb_target_group",
    "aws_cloudwatch_event_target",
}

