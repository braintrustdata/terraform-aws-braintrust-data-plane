#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Check bootstrap ordering that mocked Terraform plans cannot exercise.

Run after terraform init, or pass a saved `terraform graph -type=plan` DOT file.
This reads the dependency graph only; it never plans or applies AWS resources.
"""

import argparse
from collections import defaultdict, deque
from pathlib import Path
import re
import subprocess


def dependency_path(graph, start, target):
    pending = deque([(start, [start])])
    visited = {start}
    while pending:
        node, path = pending.popleft()
        if node == target:
            return path
        for dependency in graph[node]:
            if dependency not in visited:
                visited.add(dependency)
                pending.append((dependency, path + [dependency]))
    return None


def check_graph(dot):
    graph = defaultdict(list)
    for source, target in re.findall(r'"([^"\n]+)" -> "([^"\n]+)"', dot):
        graph[source].append(target)

    def node(suffix):
        matches = [name for name in graph if name.endswith(suffix + " (expand)")]
        if len(matches) != 1:
            raise ValueError(f"Expected one graph node for {suffix}, found {len(matches)}")
        return matches[0]

    migration = node("module.services.aws_lambda_invocation.invoke_database_migration")
    loop_group = node("module.loop_runtime_ecs.aws_security_group.task")
    baseline_rules = [
        node("module.database.aws_vpc_security_group_ingress_rule.rds_allow_ingress_from_authorized_security_groups"),
        node("module.redis.aws_vpc_security_group_ingress_rule.elasticache_allow_ingress_from_authorized_security_groups"),
        node("module.brainstore.aws_vpc_security_group_ingress_rule.brainstore_elb_allow_ingress_from_authorized_security_groups"),
        node("module.api_ecs.aws_vpc_security_group_ingress_rule.alb_ingress_http_from_internal_security_groups"),
    ]
    errors = []
    for rule in baseline_rules:
        for blocker in [migration, loop_group]:
            path = dependency_path(graph, rule, blocker)
            if path:
                errors.append("Baseline ingress must not wait for Loop or migration:\n  " + "\n  -> ".join(path))

    if not dependency_path(graph, migration, baseline_rules[0]):
        errors.append("Database migration must wait for baseline RDS ingress.")

    loop_service = node("module.loop_runtime_ecs.aws_ecs_service.loop_runtime")
    gateway_service = node("module.gateway_ecs.aws_ecs_service.gateway")
    if not dependency_path(graph, loop_service, gateway_service):
        errors.append("Loop must retain its Gateway-before-Loop startup ordering.")

    quarantine_endpoint = node("aws_vpc_endpoint.quarantine_gateway")
    quarantine_dependencies = [
        gateway_service,
        node("aws_lb_listener.gateway_quarantine_privatelink_http"),
        node("aws_lb_target_group_attachment.gateway_quarantine_privatelink_alb"),
        node("aws_vpc_endpoint_service_allowed_principal.gateway_quarantine_current_account"),
        node("aws_vpc_security_group_egress_rule.gateway_quarantine_privatelink_nlb_to_alb"),
        node("aws_vpc_security_group_ingress_rule.gateway_alb_from_quarantine_privatelink_nlb"),
        node("aws_vpc_security_group_ingress_rule.quarantine_gateway_privatelink_endpoint_http"),
        node("terraform_data.quarantine_privatelink_requirements"),
    ]
    for dependency in quarantine_dependencies:
        if not dependency_path(graph, quarantine_endpoint, dependency):
            errors.append(f"Quarantine PrivateLink must wait for its gateway and network path: {dependency}")
    for name in ["braintrust_api", "braintrust_api_ingest", "braintrust_api_background"]:
        caller = node(f"module.api_ecs.aws_ecs_task_definition.{name}")
        if not dependency_path(graph, caller, quarantine_endpoint):
            errors.append(f"API ECS must wait for the Quarantine endpoint before using its URL: {name}")

    gateway_url = node("module.gateway_ecs.output.gateway_url")
    if not dependency_path(graph, gateway_url, gateway_service):
        errors.append("The gateway URL must wait for the ECS service.")

    # Check each input directly. Inactive branches also appear in this graph.
    gateway_inputs = [
        node("module.services.var.gateway_url"),
        node("module.api_ecs.var.extra_env_vars"),
        node("module.loop_runtime_ecs.var.ai_proxy_url"),
        node("module.ingress.var.gateway_alb_dns_name"),
    ]
    for gateway_input in gateway_inputs:
        if not dependency_path(graph, gateway_input, gateway_url):
            errors.append(f"The caller input must use the gateway readiness output: {gateway_input}")

    callers = [
        node("module.services.aws_lambda_function.api_handler"),
        node("module.services.aws_lambda_function.ai_proxy"),
        node("module.api_ecs.aws_ecs_task_definition.braintrust_api"),
        node("module.api_ecs.aws_ecs_task_definition.braintrust_api_ingest"),
        node("module.api_ecs.aws_ecs_task_definition.braintrust_api_background"),
        node("module.loop_runtime_ecs.aws_ecs_task_definition.loop_runtime"),
        node("module.ingress.aws_cloudfront_distribution.dataplane"),
        node("aws_vpc_endpoint.quarantine_gateway"),
    ]
    for caller in callers:
        if not dependency_path(graph, caller, gateway_service):
            errors.append(f"Gateway cutover must wait for the ECS service: {caller}")

    api_alb = node("module.api_ecs.aws_lb.api_ecs")
    cloudfront = node("module.ingress.aws_cloudfront_distribution.dataplane")
    api_url = node("module.api_ecs.output.http_url")
    gateway_api_url = node("module.gateway_ecs.var.braintrust_api_url")
    if not dependency_path(graph, gateway_api_url, api_url):
        errors.append("Gateway API calls must use the private API endpoint.")

    gateway_api_ingress = node("module.api_ecs.aws_vpc_security_group_ingress_rule.alb_ingress_from_gateway")
    if not dependency_path(graph, gateway_service, gateway_api_ingress):
        errors.append("Gateway startup must wait for its private API ingress rule.")

    for start, target in [(migration, gateway_service), (api_alb, gateway_service), (gateway_service, cloudfront)]:
        path = dependency_path(graph, start, target)
        if path:
            errors.append("Gateway bootstrap dependency is circular or blocks migration:\n  " + "\n  -> ".join(path))

    api_parameter = node("module.api_ecs.aws_ssm_parameter.api_url")
    internal_url = node("module.api_ecs.output.internal_url")
    internal_listener = node("module.api_ecs.aws_lb_listener.api_ecs_internal")
    internal_routes = node("module.api_ecs.aws_lb_listener_rule.alb_internal_path_routes")
    for caller in [api_parameter, internal_url]:
        for dependency in [internal_listener, internal_routes, baseline_rules[-1]]:
            if not dependency_path(graph, caller, dependency):
                errors.append(f"Internal API URL must wait for its listener, routes, and baseline access: {caller} -> {dependency}")
    if dependency_path(graph, api_parameter, gateway_service):
        errors.append("Brainstore API parameter must not wait for the gateway service.")

    for service, route in [("gateway", "private_gateway"), ("loop_runtime", "private_loop_runtime")]:
        ecs_service = node(f"module.{service}_ecs.aws_ecs_service.{service}")
        target_group = node(f"module.api_ecs.output.{route}_target_group_arn")
        listener_rule = node(f"module.api_ecs.aws_lb_listener_rule.{route}")
        task_ingress = node(f"module.{service}_ecs.aws_vpc_security_group_ingress_rule.task_ingress_from_authorized_security_groups")
        for caller, dependency in [(ecs_service, target_group), (target_group, listener_rule), (ecs_service, task_ingress)]:
            if not dependency_path(graph, caller, dependency):
                errors.append(f"Direct ingress must precede ECS registration: {caller} -> {dependency}")

    if errors:
        raise ValueError("\n\n".join(errors))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--graph-file", type=Path, help="Read an existing Terraform DOT graph instead of invoking Terraform.")
    parser.add_argument("--directory", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    dot = args.graph_file.read_text() if args.graph_file else subprocess.check_output(
        ["terraform", "graph", "-type=plan"], cwd=args.directory, text=True
    )
    try:
        check_graph(dot)
    except ValueError as error:
        parser.exit(1, f"{error}\n")
    print("Network dependencies pass. Gateway readiness and internal API access precede cutover.")


if __name__ == "__main__":
    main()
